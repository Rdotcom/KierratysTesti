+// coverage for advanced single-branch star forms omitted by that proposal.
+const classifyRepeatedStarBranch = branch => {
+  let escaped = false;
+  let quoted = false;
+  let star = false;
+  let simple = true;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+    if (escaped) {
+      escaped = false;
+      simple = false;
+      continue;
+    }
+    if (ch === '\\') {
+      escaped = true;
+      simple = false;
+      continue;
