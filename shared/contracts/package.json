{
  "name": "@kierratysappi/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lookup-schema": "./src/lookup-schema.ts",
    "./collection-points": "./src/collection-points.ts",
    "./barcode-library": "./src/barcode-library.ts",
    "./photo-recognition": "./src/photo-recognition.ts",
    "./photo-image": "./src/photo-image.ts",
    "./local-vision": "./src/local-vision.ts",
    "./packaging-classifier": "./src/packaging-classifier.ts",
    "./local-vision-readiness": "./src/local-vision-readiness.ts",
    "./reference-native": "./src/reference-native.ts",
    "./offline-product": "./src/offline-product.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kierratysappi/domain": "workspace:*",
    "@kierratysappi/recycling-engine": "workspace:*",
    "zod": "4.6.7"
  }
}
