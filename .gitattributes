# Serialized model headers can look like text to Git's initial-byte heuristic.
# Never normalize, text-diff or line-merge model bytes.
*.onnx binary
# A frozen prototype digest must survive Windows core.autocrlf checkouts byte-for-byte.
mobile/app/modules/local-vision/android/src/main/assets/siglip/prototypes.json -text
# pnpm patch SHA-256 values must survive Windows core.autocrlf unchanged.
patches/*.patch text eol=lf
.pnpmfile.cjs text eol=lf
# Unified diffs require a context-space prefix, before tabs and on blank lines.
patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Frozen QA document bytes must also survive Windows core.autocrlf checkouts.
scripts/qa/protocols/* text eol=lf
